// apps/api/prisma/schema.prisma
// Phase 2 task #7: auth đã tách sang apps/auth-service (User + RefreshToken giờ
// nằm ở đó — vẫn chung 1 Postgres, chỉ tách quyền sở hữu schema, xem
// docs/adr/008-auth-service-extraction.md). apps/api KHÔNG còn model nào đụng
// tới users/refresh_tokens. Migration lịch sử (init_user, add_refresh_token) vẫn
// giữ nguyên trong prisma/migrations/ — không xóa, chỉ là bản ghi lịch sử.
// userId trên Trip vẫn không FK (cross-domain, đã cố tình từ đầu).

// output tùy chỉnh (không dùng mặc định node_modules/@prisma/client) — pnpm dedupe
// 2 app cùng version @prisma/client vào CHUNG 1 chỗ trong store, generate cho app
// này sẽ ghi đè client của app kia (apps/auth-service) nếu dùng vị trí mặc định.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
}

enum DaySlot {
  MORNING
  AFTERNOON
  EVENING
}

model Trip {
  id              String     @id @default(uuid())
  userId          String
  title           String
  destinationName String
  startDate       DateTime?  @db.Date
  days            Int
  partySize       Int
  budget          Decimal    @db.Decimal(12, 2)
  currency        String     @default("VND") @db.Char(3)
  status          TripStatus @default(DRAFT)
  aiSessionId     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  places         Place[]
  itineraryItems ItineraryItem[]

  @@index([userId, status])
  @@map("trips")
}

model Place {
  id             String   @id @default(uuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  catalogPlaceId String?
  createdAt      DateTime @default(now())

  itineraryItems ItineraryItem[]

  @@index([tripId])
  @@map("places")
}

model ItineraryItem {
  id      String @id @default(uuid())
  tripId  String
  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Restrict)

  dayNumber Int
  slot      DaySlot
  visitOrder Int

  startTime   DateTime? @db.Time
  endTime     DateTime? @db.Time
  durationMin Int?

  title       String
  description String?
  estCost     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tripId, dayNumber, slot, visitOrder])
  @@index([tripId, dayNumber])
  @@map("itinerary_items")
}
