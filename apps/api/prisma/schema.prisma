// apps/api/prisma/schema.prisma
// Phase 2 task #7: auth đã tách sang apps/auth-service (User + RefreshToken).
// Phase 3 task #2: trip đã tách sang apps/trip-service (Trip/Place/ItineraryItem,
// xem docs/learning/48-trip-service-extraction.md). apps/api giờ KHÔNG còn model
// nào — chỉ giữ JwtAuthGuard + module catalog (rỗng, chờ task #3 xây catalog-service
// riêng, xem docs/learning/49-catalog-service.md — apps/api dự kiến bị xoá hẳn sau
// task đó). Migration lịch sử (init_user, add_refresh_token, add_trip_place_itinerary)
// vẫn giữ nguyên trong prisma/migrations/ — không xóa, chỉ là bản ghi lịch sử (bảng
// vật lý vẫn còn trong Postgres, chỉ đổi service nào SỞ HỮU code động vào nó).

// output tùy chỉnh (không dùng mặc định node_modules/@prisma/client) — pnpm dedupe
// nhiều app cùng version @prisma/client vào CHUNG 1 chỗ trong store, generate cho
// app này sẽ ghi đè client của app khác nếu dùng vị trí mặc định.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
