// apps/trip-service/prisma/schema.prisma
// Phase 3 task #2: tách trip ra service riêng (trước đó nằm trong apps/api,
// xem docs/learning/48-trip-service-extraction.md). Vẫn dùng CHUNG 1 Postgres với
// apps/api/apps/auth-service (database-per-service thật là task #2 phần "sau" —
// đã quyết định gộp vào task này ở mức "sẵn sàng", chưa tách DB vật lý ngay, xem
// docs/learning/46-phase3-index.md). Chỉ tách QUYỀN SỞ HỮU schema: trip-service sở
// hữu Trip/Place/ItineraryItem, apps/api không còn model nào đụng tới 3 bảng này nữa.
// Bảng đã tồn tại sẵn trong DB (tạo bởi apps/api trước khi tách) — migration đầu
// tiên của service này phải baseline (migrate resolve --applied), KHÔNG được
// migrate dev bình thường (sẽ cố CREATE TABLE lại, lỗi vì bảng đã có) — giống hệt
// cách apps/auth-service đã làm ở Phase 2 task #7.
// userId trên Trip vẫn không FK (cross-domain, đã cố tình từ đầu).

// output tùy chỉnh (không dùng mặc định node_modules/@prisma/client) — pnpm dedupe
// nhiều app cùng version @prisma/client vào CHUNG 1 chỗ trong store, generate cho
// app này sẽ ghi đè client của app khác nếu dùng vị trí mặc định.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
}

enum DaySlot {
  MORNING
  AFTERNOON
  EVENING
}

model Trip {
  id              String     @id @default(uuid())
  userId          String
  title           String
  destinationName String
  startDate       DateTime?  @db.Date
  days            Int
  partySize       Int
  budget          Decimal    @db.Decimal(12, 2)
  currency        String     @default("VND") @db.Char(3)
  status          TripStatus @default(DRAFT)
  aiSessionId     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  places         Place[]
  itineraryItems ItineraryItem[]

  @@index([userId, status])
  @@map("trips")
}

model Place {
  id             String   @id @default(uuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  catalogPlaceId String?
  createdAt      DateTime @default(now())

  itineraryItems ItineraryItem[]

  @@index([tripId])
  @@map("places")
}

model ItineraryItem {
  id      String @id @default(uuid())
  tripId  String
  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Restrict)

  dayNumber Int
  slot      DaySlot
  visitOrder Int

  startTime   DateTime? @db.Time
  endTime     DateTime? @db.Time
  durationMin Int?

  title       String
  description String?
  estCost     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tripId, dayNumber, slot, visitOrder])
  @@index([tripId, dayNumber])
  @@map("itinerary_items")
}
